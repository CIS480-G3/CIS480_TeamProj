   "source": [
    "# this is the seed test\n",
    "seeds = [1, 10, 21, 42, 100]\n",
    "\n",
    "seed_results = []\n",
    "\n",
    "for seed in seeds:\n",
    "\n",
    "    X_train_seed, X_test_seed, y_train_seed, y_test_seed = train_test_split(\n",
    "        X,\n",
    "        y,\n",
    "        test_size=0.2,\n",
    "        random_state=seed,\n",
    "        stratify=y\n",
    "    )\n",
    "\n",
    "    seed_model = LogisticRegression(\n",
    "        max_iter=1000,\n",
    "        class_weight='balanced'\n",
    "    )\n",
    "\n",
    "    seed_model.fit(\n",
    "        X_train_seed,\n",
    "        y_train_seed\n",
    "    )\n",
    "\n",
    "    probabilities = seed_model.predict_proba(\n",
    "        X_test_seed\n",
    "    )[:, 1]\n",
    "\n",
    "    result = find_best_threshold(\n",
    "        y_test_seed,\n",
    "        probabilities\n",
    "    )\n",
    "\n",
    "    seed_results.append({\n",
    "        'Seed': seed,\n",
    "        'Threshold': result['Threshold'],\n",
    "        'False Alarm Rate (%)':\n",
    "            result['False Alarm Rate'] * 100,\n",
    "        'Recall (%)':\n",
    "            result['Recall'] * 100,\n",
    "        'Failures Caught':\n",
    "            int(result['TP']),\n",
    "        'Total Failures':\n",
    "            int(result['TP'] + result['FN'])\n",
    "    })\n",
    "\n",
    "seed_df = pd.DataFrame(seed_results)\n",
    "\n",
    "seed_df = seed_df.round(2)\n",
    "\n",
    "seed_df"
   ]
