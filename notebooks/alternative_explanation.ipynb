      ]
     },
     "execution_count": 28,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# this one is to compare the models\n",
    "weighted_result = find_best_threshold(\n",
    "    y_test,\n",
    "    weighted_prob\n",
    ")\n",
    "\n",
    "unweighted_result = find_best_threshold(\n",
    "    y_test,\n",
    "    unweighted_prob\n",
    ")\n",
    "\n",
    "comparison = pd.DataFrame([\n",
    "    {\n",
    "        'Model': 'Balanced',\n",
    "        'Threshold': weighted_result['Threshold'],\n",
    "        'False Alarm Rate (%)':\n",
    "            weighted_result['False Alarm Rate'] * 100,\n",
    "        'Recall (%)':\n",
    "            weighted_result['Recall'] * 100,\n",
    "        'False Alarms': int(weighted_result['FP']),\n",
    "        'Failures Caught': int(weighted_result['TP'])\n",
    "    },\n",
    "    {\n",
    "        'Model': 'Unweighted',\n",
    "        'Threshold': unweighted_result['Threshold'],\n",
    "        'False Alarm Rate (%)':\n",
    "            unweighted_result['False Alarm Rate'] * 100,\n",
    "        'Recall (%)':\n",
    "            unweighted_result['Recall'] * 100,\n",
    "        'False Alarms': int(unweighted_result['FP']),\n",
    "        'Failures Caught': int(unweighted_result['TP'])\n",
    "    }\n",
    "])\n",
    "\n",
    "comparison = comparison.round(2)\n",
    "\n",
    "comparison"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "55a06c25-58b5-4165-92bc-ff3403f7ea39",
